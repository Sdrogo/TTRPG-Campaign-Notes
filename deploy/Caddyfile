# HTTPS in front of the backend (context/vps-migration-plan.md, §4).
# Caddy gets and renews Let's Encrypt certificates on its own for every name
# in API_HOSTS (set in compose.yaml / the server's .env); each must already
# resolve to this server.
{$API_HOSTS} {
	# The live streams (spec 46_2, spec 52): not compressed and flushed at
	# once, so each event reaches the browser as it is sent.
	@live_stream path /rooms/*/events /rooms/*/session-zero/events
	handle @live_stream {
		reverse_proxy backend:10000 {
			flush_interval -1
		}
	}
	handle {
		encode zstd gzip
		reverse_proxy backend:10000
	}
}
