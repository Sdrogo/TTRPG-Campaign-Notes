# HTTPS in front of the backend (context/vps-migration-plan.md, §4) and,
# since ticket 73, the frontend too.
# Caddy gets and renews Let's Encrypt certificates on its own for every name
# in API_HOSTS and FRONTEND_HOSTS (set in compose.yaml / the server's .env);
# each must already resolve to this server.

# What any log line may say about a request (ticket 76): no full client
# address (IPv4 keeps its /24, IPv6 its /48), no Authorization or Cookie
# header (Caddy already redacts them; dropped anyway), and nothing in a URL
# that works as a key: invitation and friend codes, the sign-in callback's
# code and state, a signed file link's credential and signature.
(log_filter) {
	format filter {
		wrap json
		fields {
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>Proxy-Authorization delete
			# Same-origin requests carry the full page URL here (invite codes,
			# the sign-in callback's code), so it goes too.
			request>headers>Referer delete
			request>uri regexp "(/invite/|/friends/add/|/invitations/|[?&](?:code|state|X-Amz-Credential|X-Amz-Signature)=)[^/?&#]+" "${1}***"
		}
	}
}

# Caddy's own lines (errors such as a 502 log the request too) go through
# the same filter.
{
	log default {
		output stderr
		import log_filter
	}
}

# The access log (ticket 76): one JSON line per request on stdout, where
# Dozzle shows it and Docker's rotation (20 MB x 10 per container) bounds it.
(access_log) {
	log {
		output stdout
		import log_filter
	}
}

# The frontend (ticket 73 step 1): the built SPA, unpacked by deploy.sh into
# site/releases/<sha>-<time> and switched in through the site/current link.
# The headers are spec 72's (checked by caddyFrontendHeaders.test.ts);
# CSP_CONNECT_SRC lists the API origin the app talks to, and FILES_HOSTS the
# bucket's host (the app fetches some files, e.g. PDFs to preview).
{$FRONTEND_HOSTS} {
	import access_log

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' {$CSP_CONNECT_SRC} {$FILES_HOSTS}; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		-Server
	}

	root * /srv/site/current
	encode zstd gzip

	# Vite puts a content hash in every name under /assets, so a file there
	# never changes: cache it for a year. A missing one is a plain 404, not
	# the app's index.html served as JavaScript.
	handle /assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# Everything else (index.html, public/ files, and every app route through
	# the SPA fallback) is checked again on each visit, so a deploy shows up
	# at once.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# www goes to the apex, so sign-in only ever returns to
# one origin. Off by default, like FRONTEND_HOSTS.
{$FRONTEND_REDIRECT_HOSTS} {
	redir https://exlibris.world{uri} permanent
}

# The images bucket (ticket 73 step 4): Garage's S3 API. Browsers only
# fetch signed links here; the backend talks to garage:3900 directly. Every
# request needs a valid signature (the bucket is private), so the nightly
# backup from the other VPS also writes through this host. CORS for any
# origin: a link is only usable while its
# signature is. The sandbox CSP keeps a file opened here from running
# anything.
{$FILES_HOSTS} {
	import access_log

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; sandbox"
		Referrer-Policy "no-referrer"
		Access-Control-Allow-Origin "*"
		-Server
	}
	reverse_proxy garage:3900
}

# The API.
{$API_HOSTS} {
	import access_log
	# The uptime monitors' checks, every minute: not logged (as the
	# backend does), or they would bury the rest.
	@health path /health /health/*
	log_skip @health

	# Security headers on every response, the live streams included (spec 72
	# Decision 5). The API only answers JSON, SSE and files, so its CSP lets
	# nothing load and nothing frame it. HSTS: one year, this host only.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Request body caps (spec 72 Decision 6), answered with 413 before the
	# backend reads anything. An import carries a whole vault (up to 100 MB
	# in up to 3,000 files, spec 65); the largest other upload is a 20 MB
	# image. The two matchers never overlap, so their order doesn't matter.
	@imports path /rooms/*/imports /rooms/*/imports/*
	@not_imports not path /rooms/*/imports /rooms/*/imports/*
	request_body @imports {
		max_size 150MB
	}
	request_body @not_imports {
		max_size 25MB
	}

	# The live streams (spec 46_2, spec 52): not compressed and flushed at
	# once, so each event reaches the browser as it is sent.
	@live_stream path /rooms/*/events /rooms/*/session-zero/events
	handle @live_stream {
		reverse_proxy backend:10000 {
			flush_interval -1
		}
	}
	handle {
		encode zstd gzip
		reverse_proxy backend:10000
	}

	# Caddy's own 413 never passes through the backend's CORS middleware;
	# without these headers the browser reports a network error instead of
	# the status (spec 72 Decision 6). Only our own origins get them:
	# production, and staging (ticket 73 step 2).
	handle_errors 413 {
		@allowed_origin header_regexp Origin ^https://((www|staging)\.)?exlibris\.world$
		header @allowed_origin {
			Access-Control-Allow-Origin {http.request.header.Origin}
			Access-Control-Allow-Credentials true
		}
		header Vary Origin
		header Content-Type application/json
		respond `{"detail": null}` 413
	}
}
