{#- The structure shared by every style of the Room PDF (spec 23b Decision 1):
    cover, contents, one chapter per Main item, the glossary of Documents. A style's
    template only extends it (an ornament for the cover); its look is its CSS.
    Page numbers are never written here: a link carries `data-page` (the
    localized "p.") and the CSS prints the page of its target. Each paragraph is
    written on one line because the CSS keeps line breaks inside <p>. -#}
{%- macro paragraphs(items) -%}
{%- for paragraph in items -%}
<p>{% for run in paragraph %}{% if run.target %}<a class="xref" href="#{{ run.target }}" data-page="{{ manual.labels.page_abbreviation }}">{{ run.text }}</a>{% else %}{{ run.text }}{% endif %}{% endfor %}</p>
{% endfor -%}
{%- endmacro -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<title>{{ manual.title }}</title>
<link rel="stylesheet" href="styles/base.css">
<link rel="stylesheet" href="styles/{{ style }}.css">
<style>@page { size: {{ page_size }}; }</style>
</head>
<body class="style-{{ style }}">

<section class="cover">
  <div class="cover-inner">
    {% if manual.game_system %}<p class="cover-system">{{ manual.game_system }}</p>{% endif %}
    <h1 class="cover-title">{{ manual.title }}</h1>
    {% block cover_ornament %}{% endblock %}
    {% if manual.cover_image_url %}<img class="cover-image" src="{{ manual.cover_image_url }}" alt="">{% endif %}
    <p class="cover-date">{{ manual.generated_on.isoformat() }}</p>
  </div>
</section>

<nav class="toc">
  <h1 class="section-title">{{ manual.labels.contents }}</h1>
  <ol>
    {% for chapter in manual.chapters %}
    <li class="toc-chapter"><a href="#{{ chapter.id }}">{{ chapter.title }}</a>
      <ol>
        {% for document in chapter.documents %}
        <li class="toc-document"><a href="#{{ document.anchor }}">{{ document.name }}</a></li>
        {% endfor %}
      </ol>
    </li>
    {% endfor %}
    {% if manual.glossary %}
    <li class="toc-chapter"><a href="#glossary">{{ manual.labels.glossary }}</a></li>
    {% endif %}
  </ol>
</nav>

{% for chapter in manual.chapters %}
<section class="chapter" id="{{ chapter.id }}">
  <h1 class="chapter-title">{{ chapter.title }}</h1>
  <div class="chapter-body">
  {#- A chapter's references (Documents printed in an earlier chapter) come first,
      under its title, so every Document can end its own page. -#}
  {% set references = chapter.entries | rejectattr("paragraphs", "defined") | list %}
  {% if references %}
  <div class="references">
    {% for entry in references %}
    <p class="reference"><a class="xref" href="#{{ entry.anchor }}" data-page="{{ manual.labels.page_abbreviation }}">{{ entry.name }}</a></p>
    {% endfor %}
  </div>
  {% endif %}
  {% for entry in chapter.entries if entry.paragraphs is defined %}
  <article class="document{% if entry.id in shared %} shares-page{% endif %}" id="{{ entry.anchor }}">
    <h2 class="document-title">{{ entry.name }}</h2>
    {% if entry.image_url %}<figure class="document-image"><img src="{{ entry.image_url }}" alt=""></figure>{% endif %}
    <div class="description">
      {{ paragraphs(entry.paragraphs) }}
    </div>
    {% for note in entry.notes %}
    <section class="note">
      <h3>{{ note.title }}</h3>
      {{ paragraphs(note.paragraphs) }}
    </section>
    {% endfor %}
    {% if entry.comments %}
    <section class="comments">
      <h3>{{ manual.labels.comments }}</h3>
      {% for comment in entry.comments %}
      <div class="comment depth-{{ [comment.depth, 3] | min }}">
        <p class="comment-meta"><strong>{{ comment.author }}</strong> · {{ comment.written_on.isoformat() }}</p>
        {% if comment.deleted %}<p class="deleted">{{ manual.labels.deleted_comment }}</p>{% else %}{{ paragraphs(comment.paragraphs) }}{% endif %}
      </div>
      {% endfor %}
    </section>
    {% endif %}
  </article>
  {% endfor %}
  </div>
</section>
{% endfor %}

{% if manual.glossary %}
<section class="glossary" id="glossary">
  <h1 class="section-title">{{ manual.labels.glossary }}</h1>
  <div class="glossary-letters">
    {% for group in manual.glossary %}
    <div class="glossary-letter">
      <h2 class="glossary-initial">{{ group.letter }}</h2>
      {% for entry in group.entries %}
      <p class="glossary-entry"><a class="glossary-link" href="#{{ entry.anchor }}"><span class="glossary-name">{{ entry.name }}</span>{% if entry.tags %}<span class="glossary-tags"> · {{ entry.tags | join(", ") }}</span>{% endif %}</a></p>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

</body>
</html>
