SUPABASE_URL=
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=document-images
CORS_ORIGINS=["http://localhost:5173"]
# Optional pattern for per-deploy hosts, e.g. Vercel previews (blank = none):
# https://ttrpg-campaign-notes-[a-z0-9-]+-rum11\.vercel\.app
CORS_ORIGIN_REGEX=
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres
# Connections per backend process. Supabase's Session Pooler allows 15 per
# project, shared by every backend on the database (defaults 5 + 2).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
