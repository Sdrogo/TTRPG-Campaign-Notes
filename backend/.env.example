STORAGE_BUCKET=document-images
# The images bucket on S3 (Garage). deploy/garage-setup.sh fills these in on
# a server; locally, run Garage or any S3 service to upload images.
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres
# Connections per backend process (defaults 5 + 2).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
# Optional Openverse API credentials for the image search (spec 29); blank
# calls Openverse anonymously, under lower rate limits.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Sign-in (ticket 73 step 3). The API's public address, where the providers
# send users back: register <API_PUBLIC_URL>/auth/<provider>/callback in each
# provider's console.
API_PUBLIC_URL=http://localhost:8000
# Required, at least 32 characters: openssl rand -base64 48
AUTH_TOKEN_SECRET=
# OAuth apps; a provider with no client id is not offered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# FastAPI's /docs, /redoc and /openapi.json (spec 72): off unless true.
API_DOCS_ENABLED=true
