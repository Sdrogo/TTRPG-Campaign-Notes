SUPABASE_URL=
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=document-images
# The bucket on S3 (Garage) instead of Supabase Storage; leave S3_ENDPOINT
# empty to keep Supabase. deploy/garage-setup.sh fills these in on a server.
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CORS_ORIGINS=["http://localhost:5173"]
# Optional pattern for per-deploy hosts, e.g. Vercel previews (blank = none):
# https://ttrpg-campaign-notes-[a-z0-9-]+-rum11\.vercel\.app
CORS_ORIGIN_REGEX=
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres
# Connections per backend process. Supabase's Session Pooler allows 15 per
# project, shared by every backend on the database (defaults 5 + 2).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
# Optional Openverse API credentials for the image search (spec 29); blank
# calls Openverse anonymously, under lower rate limits.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Sign-in (ticket 73 step 3). The API's public address, where the providers
# send users back: register <API_PUBLIC_URL>/auth/<provider>/callback in each
# provider's console.
API_PUBLIC_URL=http://localhost:8000
# Required, at least 32 characters: openssl rand -base64 48
AUTH_TOKEN_SECRET=
# OAuth apps; a provider with no client id is not offered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# FastAPI's /docs, /redoc and /openapi.json (spec 72): off unless true.
API_DOCS_ENABLED=true
